{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "Web API Requests Rate (RPS)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m])) by (endpoint)",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "Web API P95 Latency (Seconds)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[1m])) by (le, endpoint))",
          "legendFormat": "P95 {{endpoint}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "id": 3,
      "title": "MCP Tool Call Rate (Calls/sec)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(mcp_tool_calls_total[1m])) by (tool_name, status)",
          "legendFormat": "{{tool_name}} ({{status}})",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "id": 4,
      "title": "LLM Token Consumption (Tokens/sec)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(llm_prompt_tokens_total[1m])) by (model)",
          "legendFormat": "Prompt Tokens - {{model}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(llm_completion_tokens_total[1m])) by (model)",
          "legendFormat": "Completion Tokens - {{model}}",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "id": 5,
      "title": "LLM Latency P90 (Seconds)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.90, sum(rate(llm_request_duration_seconds_bucket[1m])) by (le, model))",
          "legendFormat": "P90 {{model}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["mlops", "kagent", "telemetry", "observability"],
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "E-Commerce AI Agent & MLOps Telemetry Dashboard",
  "uid": "agent-observability-dashboard"
}
